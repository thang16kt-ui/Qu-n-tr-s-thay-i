# Chỉ gồm giá trị CÔNG KHAI (được nhúng vào trang web). Khoá bí mật nằm trong Supabase (private.settings).
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Khi deploy dưới thư mục con (GitHub Pages: /ten-repo). Để trống nếu chạy ở gốc tên miền.
NEXT_PUBLIC_BASE_PATH=
